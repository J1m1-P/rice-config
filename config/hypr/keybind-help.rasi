/* Dedicated keybind-help theme. It does not affect the normal Rofi launcher. */
* {
    background: #000000eb;
    foreground: #e8e8e8;
    muted: #737373;
    blue: #728DBE;
    green: #00ff99;
    font: "DejaVu Sans Mono 12";
}

window {
    location: center;
    anchor: center;
    width: 710px;
    height: 510px;
    padding: 14px;
    border: 1px;
    border-color: @blue;
    border-radius: 11px;
    background-color: @background;
}

mainbox {
    children: [ inputbar, listview, message ];
    spacing: 8px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    padding: 8px;
    border: 0px 0px 1px 0px;
    border-color: #252525;
    background-color: #000000;
}

prompt {
    padding: 0px 8px 0px 2px;
    text-color: @green;
    background-color: transparent;
}

entry {
    placeholder: "search...";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
    hide-cursor-on-empty: true;
    blink: false;
}

listview {
    columns: 1;
    lines: 11;
    spacing: 3px;
    scrollbar: true;
    fixed-height: true;
    dynamic: false;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: 2px;
    background-color: transparent;
}

element normal.normal,
element alternate.normal { text-color: @foreground; background-color: transparent; }
element selected.normal { border-color: @blue; text-color: @foreground; background-color: transparent; }

element-text {
    vertical-align: 0.5;
    tab-stops: [ 290px ];
    text-color: inherit;
    background-color: transparent;
}

scrollbar { width: 2px; handle-color: @blue; background-color: #181818; }

message {
    padding: 8px 4px 2px 4px;
    border: 1px 0px 0px 0px;
    border-color: #252525;
    background-color: transparent;
}

textbox { horizontal-align: 0.5; text-color: @muted; background-color: transparent; }
