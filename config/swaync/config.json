{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-exclusive-zone": true,
  "control-center-margin-top": 38,
  "control-center-margin-bottom": 18,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 430,
  "control-center-height": 760,
  "notification-window-width": 430,
  "notification-window-height": 760,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": false,
  "text-empty": "✓  No notifications",
  "script-fail-notify": true,
  "widgets": [
    "mpris",
    "volume",
    "backlight",
    "title#notification-title",
    "dnd#notification-dnd",
    "notifications"
  ],
  "widget-config": {
    "mpris": {
      "blacklist": [],
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "No active audio streams",
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃",
      "animation-type": "slide_down",
      "animation-duration": 160
    },
    "backlight": {
      "label": "󰃠",
      "device": "nvidia_wmi_ec_backlight",
      "subsystem": "backlight",
      "min": 1
    },
    "title#notification-title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd#notification-dnd": {
      "text": "DND"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
