{
    "custom/swaync": {"exec": "$HOME/.local/bin/waybar-swaync", "restart-interval": 5, "return-type": "json", "format": "{icon}{text}", "format-icons": {"normal-notification": "󰒓", "normal-none": "󰒓", "dnd-notification": "󰒓", "dnd-none": "󰒓", "inhibited-notification": "󰒓", "inhibited-none": "󰒓", "dnd-inhibited-notification": "󰒓", "dnd-inhibited-none": "󰒓"}, "escape": true, "on-click": "swaync-client --skip-wait --toggle-panel", "on-click-right": "swaync-client --skip-wait --toggle-dnd"},
    "network#wifi": {"interface": "wl*", "format-wifi": " {signalStrength}%", "format-linked": "", "format-disconnected": "", "format-disabled": "", "tooltip-format-wifi": "NETWORK\n\n{essid}\nSignal: {signalStrength}%\nInterface: {ifname}\nIPv4: {ipaddr}", "on-click": "pidof wlctl >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e wlctl\""},
    "network#ethernet": {"interface": "en*", "format-ethernet": "󰈀", "format-linked": "", "format-disconnected": "", "tooltip-format-ethernet": "NETWORK\n\nEthernet\nInterface: {ifname}\nIPv4: {ipaddr}", "on-click": "pidof nmtui >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e nmtui\""},
    "bluetooth": {"format-disabled": "", "format-off": "", "format-on": "󰂯", "format-connected": "󰂱", "format-connected-battery": "󰂱 {device_battery_percentage}%", "format-no-controller": "", "tooltip-format": "{status}\n{device_enumerate}", "on-click": "pidof bluetui >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e bluetui\""},
    "pulseaudio": {"format": "{icon} {volume}%", "format-bluetooth": "{icon} {volume}%", "format-muted": "󰖁 {volume}%", "format-icons": {"default": ["󰕿", "󰖀", "󰕾"]}, "tooltip-format": "{desc}\nVolume: {volume}%", "on-click": "pidof wiremix >/dev/null || hyprctl dispatch exec \"[float; size (monitor_w*0.9) (monitor_h*0.9); center] kitty -e wiremix\"", "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "scroll-step": 0},
    "custom/microphone": {"exec": "$HOME/.local/bin/waybar-microphone", "return-type": "json", "interval": 1, "format": "{text}", "on-click": "$HOME/.local/bin/waybar-microphone toggle"},
    "battery": {"states": {"warning": 30, "critical": 15}, "format": "{icon} {capacity}%", "format-charging": "󰂄 {capacity}%", "format-plugged": "󰂄 {capacity}%", "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"], "tooltip-format": "BATTERY\n\n{capacity}%\nEstimated: {time}"},
    "group/battery-drawer": {"orientation": "horizontal", "modules": ["battery", "power-profiles-daemon"], "drawer": {"transition-duration": 250, "click-to-reveal": true, "children-class": "battery-child"}},
    "power-profiles-daemon": {"format": "{profile}", "tooltip-format": "Power profile: {profile}\nDriver: {driver}\nClick to cycle", "tooltip": true},
    "tray": {"icon-size": 16, "spacing": 6}
}
