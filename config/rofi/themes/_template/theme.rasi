@import "settings.rasi"

* {
    font: var(theme-font, "DejaVu Sans Mono 12");
    text-color: var(text, #eeeeee);
}

window {
    width: var(window-width, 520px);
    padding: var(window-padding, 12px);
    border: var(border-width, 1px);
    border-color: var(panel-border, #ffffff);
    background-color: var(window-bg, #000000);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: var(row-spacing, 4px);
}

inputbar {
    children: [ prompt, entry ];
    padding: var(input-padding, 8px);
}

prompt {
    padding: 0px 8px 0px 2px;
    text-color: var(text, #eeeeee);
}

entry { placeholder: ""; }

listview {
    lines: var(visible-results, 8);
    columns: 1;
    spacing: var(row-spacing, 4px);
    scrollbar: false;
    fixed-height: true;
}

element {
    padding: var(row-padding, 7px);
    border-radius: var(window-radius, 10px);
}

element-icon { size: var(icon-size, 21px); }
element-text { text-color: var(text, #eeeeee); }
element selected { background-color: var(selected-bg, #222222); }
